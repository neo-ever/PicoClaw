# OpenAI-compatible provider. Never commit a real API key.
PICOCLAW_PROVIDER=openai
PICOCLAW_MODEL=your-model-id
PICOCLAW_API_KEY=your-api-key
PICOCLAW_BASE_URL=https://your-openai-compatible-endpoint.example/v1
PICOCLAW_TIMEOUT=60

# Local Ollama fallback (does not need an API key).
# PICOCLAW_PROVIDER=ollama
# PICOCLAW_OLLAMA_MODEL=qwen3.5:4b
# PICOCLAW_OLLAMA_HOST=http://127.0.0.1:11434
# PICOCLAW_OLLAMA_TIMEOUT=300
# PICOCLAW_OLLAMA_TEMPERATURE=0.2
